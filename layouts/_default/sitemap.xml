{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range .Data.Pages -}}
  {{- if not .Draft -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- $cf := .Params.sitemap.changefreq | default (.Params.changefreq | default (cond (or (eq .Kind "home") (eq .Kind "section") (eq .Kind "taxonomy")) "weekly" "monthly")) -}}
    <changefreq>{{ $cf }}</changefreq>
    {{- $pr := .Params.sitemap.priority | default (.Params.priority | default (cond (eq .Kind "home") 1.0 (cond (eq .Kind "section") 0.8 (cond (eq .Kind "term") 0.4 (cond (eq .Kind "taxonomy") 0.3 0.7))))) -}}
    <priority>{{ printf "%.1f" $pr }}</priority>
  </url>
  {{- end -}}
{{- end -}}
  <!-- Key resources for AI agents, scrapers and SEO -->
  <url>
    <loc>https://mccrudd3n.com/llms.txt</loc>
    <lastmod>2026-06-14T00:00:00+00:00</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://mccrudd3n.com/llms-full.txt</loc>
    <lastmod>2026-06-14T00:00:00+00:00</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
